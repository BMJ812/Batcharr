{
    "name": "batcharr",
    "version": "0.1.1",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --ignore-pattern \"dist/**\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "discord:register": "node scripts/register-discord-commands.mjs",
        "build:discord-gateway": "esbuild scripts/discord-gateway.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/discord-gateway.cjs"
    },
    "dependencies": {
        "discord-interactions": "^4.4.0",
        "discord.js": "^14.27.0",
        "next": "16.2.10",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tsx": "^4.23.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^26.1.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "esbuild": "^0.28.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.10",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "postcss": "8.5.20"
    }
}
