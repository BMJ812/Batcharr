# Required for encrypted API-key storage. Keep this value stable across restores.
BATCHARR_SECRET=replace-with-at-least-32-random-characters

# Optional. When blank, Batcharr has no login screen and should remain LAN/Tailscale only.
BATCHARR_PASSWORD=change-this-password

# Set true only when Batcharr is served through HTTPS.
BATCHARR_COOKIE_SECURE=false

PUID=99
PGID=100
TZ=America/Los_Angeles
